# ============================================
# EduMatrix 智教矩阵 - 环境变量配置
# 复制此文件为 .env（可选）
# API Key 只能由后端环境注入；浏览器设置页不会保存或发送模型密钥。
# 不使用真实模型时保留 deterministic 默认值即可。
# ============================================

# ---- LLM 配置（后端唯一配置边界） ----
EDUMATRIX_LLM_PROVIDER=deterministic
EDUMATRIX_LLM_ENDPOINT=
EDUMATRIX_LLM_API_KEY=
EDUMATRIX_LLM_MODEL=deterministic
EDUMATRIX_LLM_TEMPERATURE=0.3
EDUMATRIX_LLM_MAX_TOKENS=16384
EDUMATRIX_LLM_TIMEOUT=120
# enabled / disabled / max; max also sends reasoning_effort=max
EDUMATRIX_LLM_THINKING_MODE=
EDUMATRIX_LLM_REASONING_EFFORT=
# Optional emergency downgrade; leave unset for honest live-model failures.
EDUMATRIX_ALLOW_LLM_FALLBACK=0

# ---- 多模态视觉模型（OpenAI-compatible fallback，可选） ----
# 主模型不支持图片时，带图片的请求会路由到这里。
EDUMATRIX_MULTIMODAL_LLM_PROVIDER=
EDUMATRIX_MULTIMODAL_LLM_ENDPOINT=
EDUMATRIX_MULTIMODAL_LLM_API_KEY=
EDUMATRIX_MULTIMODAL_LLM_MODEL=

# ---- 并发控制 ----
EDUMATRIX_MAX_CONCURRENT_LLM=8
EDUMATRIX_LLM_RATE_LIMIT_RPM=120
EDUMATRIX_LLM_RATE_LIMIT_TPM=100000
EDUMATRIX_CIRCUIT_BREAKER_THRESHOLD=5
EDUMATRIX_CIRCUIT_BREAKER_WINDOW=60
EDUMATRIX_RETRY_MAX_ATTEMPTS=3
EDUMATRIX_REQUEST_QUEUE_SIZE=200

# ---- In-process cache governance ----
EDUMATRIX_CACHE_MAX_ENTRIES=256
EDUMATRIX_CACHE_TTL_SECONDS=900
EDUMATRIX_SEARCH_CACHE_MAX_ENTRIES=128

# ---- 嵌入配置（默认 hash，不需下载） ----
EDUMATRIX_EMBEDDING_PROVIDER=hash

# ---- 检索配置 ----
EDUMATRIX_TOP_K=6
EDUMATRIX_DEBATE_MIN_SCORE=0.42
EDUMATRIX_ALIGNMENT_THRESHOLD=0.65
EDUMATRIX_ROLLBACK_LIMIT=2

# ---- FAISS（默认关闭） ----
EDUMATRIX_USE_FAISS=0

# ---- 讯飞星火（备选 LLM） ----
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=

# ---- Authentication and safety ----
# Use a stable random value (at least 32 characters) locally so backend restarts
# do not invalidate the browser session; use a unique value in production.
EDUMATRIX_ENV=development
EDUMATRIX_AUTH_SECRET_KEY=
EDUMATRIX_RELOAD=0
EDUMATRIX_AUTH_ALGORITHM=HS256
EDUMATRIX_AUTH_TOKEN_EXPIRE_MINS=1440
EDUMATRIX_DEMO_MODE=0
EDUMATRIX_MAX_UPLOAD_BYTES=20971520
EDUMATRIX_MAX_DOCUMENT_PAGES=200
EDUMATRIX_MAX_ARCHIVE_MEMBERS=2000
EDUMATRIX_MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
EDUMATRIX_DOCUMENT_PARSE_TIMEOUT=45
EDUMATRIX_MAX_WEB_CONTENT_CHARS=200000
# disabled = code execution off; no Docker required for the core learning loop
# trusted_local = local research/demo mode; restricted child process without container isolation
# docker = Docker container isolation for code execution
EDUMATRIX_SANDBOX_MODE=disabled
EDUMATRIX_SANDBOX_MAX_OUTPUT_BYTES=100000
EDUMATRIX_SANDBOX_MAX_VISUAL_BYTES=5000000
